{
  "name": "kavoom",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "description": "KAVOOM: a line game for the browser, local and online",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server/server.js",
    "check": "npm run lint && npm run format:check && npm test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vite build --logLevel warn && node --test tests/*.test.js",
    "e2e": "node tests/e2e/smoke.cjs",
    "bump": "node scripts/bump.mjs"
  },
  "dependencies": {
    "@fontsource/heebo": "^5.3.0",
    "@fontsource/secular-one": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/matan0810/kavoom.git"
  },
  "homepage": "https://kavoom.onrender.com",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "playwright": "1.63.0",
    "prettier": "^3.10.1",
    "vite": "^8.3.8"
  }
}
