{
  "name": "KAVOOM",
  "short_name": "KAVOOM",
  "description": "Line game for 2 to 6 players: on one device or online, with bots and power-ups.",
  "start_url": "./",
  "display": "fullscreen",
  "orientation": "any",
  "background_color": "#0a0d1c",
